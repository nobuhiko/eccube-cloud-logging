{
    "name": "nobuhiko/eccube-cloud-logging",
    "description": "EC-CUBE を Cloud Run などで動かすときのログ（Cloud Logging の JSON・個人情報を伏せる・リクエストの trace）。Monolog 2 / 3 の部品と EC-CUBE 2 系のつなぎ",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "ec-cube",
        "eccube",
        "monolog",
        "cloud-logging",
        "cloud-run",
        "gcp"
    ],
    "authors": [
        {
            "name": "KIMOTO Nobuhiko",
            "homepage": "https://github.com/nobuhiko"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "monolog/monolog": "^2.9 || ^3.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5"
    },
    "autoload": {
        "psr-4": {
            "Nobuhiko\\EccubeCloudLogging\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nobuhiko\\EccubeCloudLogging\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
